---
import { getCollection } from 'astro:content';
import Portrait from '../components/Portrait.astro';
import WorkCard from '../components/WorkCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

const featuredWork = (await getCollection('work'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => a.data.order - b.data.order);

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${SITE.url}/#person`,
	name: SITE.name,
	url: SITE.url,
	email: `mailto:${SITE.email}`,
	image: `${SITE.url}/images/ioannis-papathanasiou-social.jpg`,
	homeLocation: { '@type': 'Place', name: SITE.location },
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Aristotle University of Thessaloniki',
		url: 'https://www.auth.gr/en/',
	},
	sameAs: [SITE.github, SITE.linkedin],
	knowsAbout: [
		'Neutron-star equations of state',
		'Relativistic stellar structure',
		'Computational physics',
		'Scientific software',
	],
};
---

<BaseLayout
	jsonLd={personJsonLd}
	ogImage="/images/ioannis-papathanasiou-social.jpg"
	ogImageAlt="Portrait of Ioannis Papathanasiou with a city at night in the background"
>
	<section class="shell hero" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="eyebrow">Ioannis Papathanasiou · Computational physicist</p>
			<h1 id="hero-title">Computational physics for neutron-star matter.</h1>
			<p class="hero-intro">
				I’m a physics graduate and early-career computational physicist based in Thessaloniki,
				Greece. My work combines dense-matter equations of state, relativistic stellar structure,
				and reproducible scientific software.
			</p>
			<p class="hero-focus">
				My current methods work uses controlled sound-speed deformations of analytical BSk24 to
				study how thermodynamically admissible changes propagate to stellar and tidal observables.
			</p>
			<div class="link-row">
				<a class="button-link" href="/work/">View selected work <span aria-hidden="true">→</span></a>
				<a class="button-link secondary" href={`mailto:${SITE.email}`}>Email me</a>
			</div>
		</div>
		<Portrait priority />
	</section>

	<section class="section" aria-labelledby="selected-work-title">
		<div class="shell">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Selected work</p>
					<h2 id="selected-work-title">A focused research trajectory</h2>
				</div>
				<p>
					The portfolio is intentionally selective. It leads with the current BSk24 method, then
					shows how a synthetic undergraduate classification study developed into a more careful
					account of validation and scientific scope.
				</p>
			</div>
			<div class="work-grid">
				{featuredWork.map((entry, index) => <WorkCard entry={entry} index={index} />)}
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="working-principles-title">
		<div class="shell">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Working principles</p>
					<h2 id="working-principles-title">Clarity is part of the method.</h2>
				</div>
				<p>
					I am most interested in computational work where assumptions, numerical capability, and
					the boundary of the claim can be inspected—not merely inferred from a final plot.
				</p>
			</div>
			<div class="principles-grid">
				<article class="principle">
					<h3>Fail closed</h3>
					<p>Keep rejected physical or numerical cases visible instead of repairing them silently.</p>
				</article>
				<article class="principle">
					<h3>Record provenance</h3>
					<p>Connect configurations, sources, environments, and outputs through reproducible records.</p>
				</article>
				<article class="principle">
					<h3>State the boundary</h3>
					<p>Separate what a model demonstrates from composition, observation, or physics it cannot establish.</p>
				</article>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="education-title">
		<div class="shell section-heading">
			<div>
				<p class="section-kicker">Education</p>
				<h2 id="education-title">Physics, AUTh</h2>
			</div>
			<div>
				<p>
					Degree in Physics, Aristotle University of Thessaloniki, 2026 · 240 ECTS · 8.46/10
					(“Very Good”). Undergraduate thesis: 10/10.
				</p>
				<div class="link-row">
					<a class="text-link" href="/about/">Background and approach <span aria-hidden="true">→</span></a>
					<a class="text-link" href="/outputs/">Public outputs <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
