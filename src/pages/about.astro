---
import Portrait from '../components/Portrait.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${SITE.url}/#person`,
	name: SITE.name,
	url: SITE.url,
	email: `mailto:${SITE.email}`,
	image: `${SITE.url}/images/ioannis-papathanasiou-social.jpg`,
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Aristotle University of Thessaloniki',
		url: 'https://www.auth.gr/en/',
	},
	sameAs: [SITE.github, SITE.linkedin],
};
---

<BaseLayout
	title="About — Ioannis Papathanasiou"
	description="Background, education, and scientific approach of Ioannis Papathanasiou, an early-career computational physicist in Thessaloniki."
	canonicalPath="/about/"
	jsonLd={personJsonLd}
	ogImage="/images/ioannis-papathanasiou-social.jpg"
	ogImageAlt="Portrait of Ioannis Papathanasiou with a city at night in the background"
>
	<header class="shell page-header">
		<p class="eyebrow">Background and approach</p>
		<h1>Physics, computation, and careful claims.</h1>
	</header>

	<section class="shell about-grid" aria-label="About Ioannis Papathanasiou">
		<Portrait />
		<div class="about-copy">
			<p>
				I am an early-career computational physicist interested in problems where dense-matter
				physics, numerical methods, and careful scientific software meet. My current work focuses
				on controlled variations of neutron-star equations of state and the propagation of those
				changes to equilibrium and tidal observables.
			</p>
			<p>
				My undergraduate thesis used synthetic equations of state, relativistic stellar
				structure, and machine learning to investigate compact-star model discrimination. A later
				audit of that work sharpened my interest in data provenance, group-aware validation, and
				the difference between a useful model result and a general physical conclusion.
			</p>
			<p>
				I value explicit assumptions, fail-closed validation, reproducible calculation records,
				and a clear separation between what a model demonstrates and what remains unknown.
			</p>

			<dl class="fact-list">
				<dt>Education</dt>
				<dd>Degree in Physics, Aristotle University of Thessaloniki, 2026</dd>
				<dt>Degree record</dt>
				<dd>240 ECTS · 8.46/10 (“Very Good”)</dd>
				<dt>Thesis</dt>
				<dd>
					<em>Machine Learning Classification of Neutron Star Composition</em> · 10/10
				</dd>
				<dt>Supervision</dt>
				<dd>Charalampos Moustakidis and Theodoros Diakonidis</dd>
				<dt>Location</dt>
				<dd>{SITE.location}</dd>
				<dt>Contact</dt>
				<dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
			</dl>

			<div class="link-row">
				<a class="button-link" href={`mailto:${SITE.email}`}>Start a conversation</a>
				<a class="button-link secondary" href="/cv/">View CV</a>
			</div>
		</div>
	</section>
</BaseLayout>
