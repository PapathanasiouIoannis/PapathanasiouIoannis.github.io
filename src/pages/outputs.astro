---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIVE_APPS, PREPRINT, REPOSITORIES, SITE } from '../site';
import { PREPRINT_JSON_LD } from '../structuredData';

const outputJsonLd = [
	PREPRINT_JSON_LD,
	{
		'@context': 'https://schema.org',
		'@type': 'SoftwareSourceCode',
		name: 'EoS Generation',
		version: '1.0.0',
		programmingLanguage: 'Python',
		codeRepository: REPOSITORIES.eosGeneration,
		url: REPOSITORIES.eosGenerationRelease,
		license: 'https://opensource.org/license/mit',
		author: { '@id': `${SITE.url}/#person` },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Dataset',
		name: 'BSk24 fixed-geometry signed-amplitude campaign data',
		version: '1.0.0',
		url: REPOSITORIES.eosCampaignRelease,
		license: 'https://creativecommons.org/licenses/by/4.0/',
		creator: { '@id': `${SITE.url}/#person` },
		distribution: {
			'@type': 'DataDownload',
			encodingFormat: 'application/zip',
			contentUrl:
				'https://github.com/PapathanasiouIoannis/EoS-generation/releases/download/bsk24-campaign-data-v1.0.0/bsk24-final-amplitude-campaign-v1-derived-evidence.zip',
		},
	},
];
---

<BaseLayout
	title="Public outputs — Ioannis Papathanasiou"
	description="The sole-authored arXiv preprint, versioned research software, campaign data, thesis record, and scientific demonstrations of Ioannis Papathanasiou."
	canonicalPath="/outputs/"
	jsonLd={outputJsonLd}
	ogImage="/images/bsk24-thermodynamic-propagation-social.jpg"
	ogImageAlt="Three plots show how negative and positive BSk24 sound-speed deformations accumulate into pressure responses."
>
	<header class="shell page-header">
		<p class="eyebrow">Preprint, software, data, and thesis</p>
		<h1>Public outputs.</h1>
		<p class="page-lede">
			Research outputs that can be inspected and cited now, with preprint status, artifact
			provenance, and scientific scope stated explicitly.
		</p>
	</header>

	<section class="shell output-list" aria-label="Public output list">
		<article class="output-item output-item--preprint">
			<p class="output-type">arXiv preprint · <time datetime={PREPRINT.submitted}>2026</time></p>
			<div>
				<h2>{PREPRINT.title}</h2>
				<p class="output-citation">
					{PREPRINT.author}, sole author · {PREPRINT.identifier} [{PREPRINT.primaryCategory}] ·
					submitted <time datetime={PREPRINT.submitted}>2026-08-24</time> · cross-listed in{' '}
					{PREPRINT.crossList} · 19 pages, 10 figures, 6 tables.
				</p>
				<p>
					A controlled study of how signed local sound-speed changes propagate through
					thermodynamic reconstruction and central-state relocation into a mass-dependent,
					nonlinear, sign-asymmetric neutron-star response. The effective barotropes are not
					BSk24 predictions or evidence for a microscopic composition or phase transition.
				</p>
				<p class="output-note">
					Public preprint; not peer reviewed, not a journal publication or journal-accepted work.
					No journal submission is planned.
				</p>
				<div class="link-row">
					<a class="text-link" href={PREPRINT.record}>arXiv record <span aria-hidden="true">↗</span></a>
					<a class="text-link" href={PREPRINT.pdf}>PDF <span aria-hidden="true">↗</span></a>
					<a class="text-link" href={PREPRINT.bibtex}>BibTeX <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/work/bsk24-sound-speed-deformations/">Research context <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>

		<article class="output-item">
			<p class="output-type">Software · v1.0.0</p>
			<div>
				<h2>EoS Generation</h2>
				<p>
					A focused Python implementation of controlled BSk24 sound-speed deformations,
					thermodynamic assessment, reconstruction, and optional TOV/tidal calculations. MIT
					licensed, tested, documented, and supplied with citation metadata.
				</p>
				<div class="link-row">
					<a class="text-link" href={REPOSITORIES.eosGenerationRelease}>Release <span aria-hidden="true">↗</span></a>
					<a class="text-link" href={REPOSITORIES.eosGeneration}>Repository <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</article>

		<article class="output-item">
			<p class="output-type">Data · v1.0.0</p>
			<div>
				<h2>BSk24 signed-amplitude campaign evidence</h2>
				<p>
					Analysis-ready tables, figures, campaign declarations, provenance records, checksums,
					and sanitized calculation/reporting source. Released data and figures are CC BY 4.0;
					released code is MIT licensed.
				</p>
				<div class="link-row">
					<a class="text-link" href={REPOSITORIES.eosCampaignRelease}>Data release <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/work/bsk24-sound-speed-deformations/">Read the case study <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>

		<article class="output-item">
			<p class="output-type">Undergraduate thesis · <time datetime="2026-02">2026</time></p>
			<div>
				<h2>Machine Learning Classification of Neutron Star Composition</h2>
				<p>
					A synthetic compact-star model-discrimination study examined in February 2026 (10/10).
					The examined thesis is distinct from the later methodological redevelopment and from
					the BSk24 preprint.
				</p>
				<div class="link-row">
					<a class="text-link" href="/work/compact-star-model-discrimination/">Thesis and redevelopment context <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>

		<article class="output-item">
			<p class="output-type">Software · public demonstrations</p>
			<div>
				<h2>Interactive compact-star classifier demonstrations</h2>
				<p>
					Two independent post-thesis applications expose retained classifier artifacts as
					restricted synthetic model scores. They are not observational inference services or
					composition-probability tools.
				</p>
				<div class="link-row">
					<a class="text-link" href="/apps/">Scope and launch notes <span aria-hidden="true">→</span></a>
					<a class="text-link" href={LIVE_APPS.clean}>Baseline demonstration <span aria-hidden="true">↗</span></a>
					<a class="text-link" href={LIVE_APPS.perturbed}>Perturbation sensitivity <span aria-hidden="true">↗</span></a>
				</div>
			</div>
		</article>

		<article class="output-item">
			<p class="output-type">Ongoing software · alpha</p>
			<div>
				<h2>Neutron-star EoS toolkit</h2>
				<p>
					Early-stage development work for analytical, CSV, and cold one-dimensional CompOSE
					inputs and continuous source-boundary TOV backgrounds. It has no formal release or
					public benchmark result packet; the repository link is omitted while public-scope and
					citation wording remain under review.
				</p>
				<div class="link-row">
					<a class="text-link" href="/work/neutron-star-eos-toolkit/">Scope and limitations <span aria-hidden="true">→</span></a>
				</div>
			</div>
		</article>
	</section>
</BaseLayout>
