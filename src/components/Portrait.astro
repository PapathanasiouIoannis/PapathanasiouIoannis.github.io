---
import { Picture } from 'astro:assets';
import portrait from '../assets/ioannis-papathanasiou.jpg';

interface Props {
	priority?: boolean;
}

const { priority = false } = Astro.props;
---

<figure class="portrait-frame">
	<Picture
		src={portrait}
		formats={['avif', 'webp']}
		widths={[420, 640, 900]}
		sizes="(max-width: 680px) calc(100vw - 2.5rem), (max-width: 860px) 352px, 400px"
		alt="Portrait of Ioannis Papathanasiou overlooking a city at night"
		loading={priority ? 'eager' : 'lazy'}
		fetchpriority={priority ? 'high' : 'auto'}
		decoding="async"
	/>
</figure>
