---
import { SITE } from '../site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell footer-inner">
		<div>
			<p class="footer-title">Open to careful scientific conversations.</p>
			<p class="footer-note">
				This site is deliberately static: no analytics, cookies, trackers, or third-party embeds.
				© {year} {SITE.name}.
			</p>
		</div>
		<nav class="footer-links" aria-label="Footer links">
			<a href={`mailto:${SITE.email}`}>Email</a>
			<a href={SITE.github}>GitHub <span aria-hidden="true">↗</span></a>
			<a href={SITE.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
		</nav>
	</div>
</footer>
